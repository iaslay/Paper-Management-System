# 默认使用项目 data 目录与 SQLite，无需配置即可本机运行。
# PAPERBOARD_DATA_DIR=C:/自己的数据目录
# 使用 PostgreSQL 时显式配置连接地址；第一阶段尚未进行 PostgreSQL 实机验收。
# PAPERBOARD_DATABASE_URL=postgresql+psycopg://账号:密码@127.0.0.1:5432/paperboard
# 私人服务器通过 HTTPS 访问时使用以下配置，并填写真实来源地址。
# PAPERBOARD_COOKIE_SECURE=1
# PAPERBOARD_ALLOWED_ORIGINS=https://自己的域名
# 模型密钥在应用设置中填写，Windows 本机主密钥由当前系统账号保护。
# 可选：使用有效 Fernet 主密钥替代本机主密钥文件，迁移时应单独保护。
# PAPERBOARD_SECRET_KEY=有效的主密钥
# 以下仅供独立开发验收，正式使用保持默认值。
# PAPERBOARD_ALLOW_LOCAL_MODEL=0
# PAPERBOARD_AI_WORKER=1
# PAPERBOARD_FRONTEND_DIR=C:/独立构建目录
